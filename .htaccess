# À utiliser UNIQUEMENT si le document root du sous-domaine ne peut pas
# être défini directement sur le dossier "public/" dans Hostinger.
# Si tu peux configurer la racine sur public/, supprime ce fichier :
# il ne sert à rien dans ce cas (et le .htaccess de public/ suffit).

RewriteEngine On

# Bloque l'accès direct à tout ce qui n'est pas dans public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule ^(.*)$ /public/$1 [L]

# Empêche l'accès direct aux dossiers sensibles si jamais atteints
RewriteRule ^(app|routes|storage|vendor)/ - [F,L]

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "composer\.(json|lock)$">
    Require all denied
</FilesMatch>
